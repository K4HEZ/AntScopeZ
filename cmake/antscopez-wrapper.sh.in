#!/bin/sh
#
# Generated by CMakeLists.txt at configure time (configure_file()) -- do
# not edit this file directly, edit cmake/antscopez-wrapper.sh.in instead.
#
# This is installed at bindir/AntScopeZ; the real binary lives in the
# private libdir/antscopez directory instead (as AntScopeZ.bin), deliberately
# kept out of the shared bindir -- see the qt.conf comment next to
# GENERATE_QT_CONF in CMakeLists.txt for why (a qt.conf sitting in bindir
# would apply to every other Qt application launched from there, not just
# this one). This wrapper is the only thing this package puts in bindir.
#
# LD_LIBRARY_PATH is exported (rather than relying on RPATH alone) because
# $ORIGIN-relative RPATH on the binary/plugins isn't sufficient by itself
# for Qt's plugin loader to reliably resolve every symbol it needs from
# the bundled Qt 6.11 libraries -- confirmed by testing that setting
# LD_LIBRARY_PATH explicitly (below) fixes a real crash
# ("qxcb: undefined symbol ... version Qt_6_PRIVATE_API") that RPATH alone
# does not, even though the resolved library files are identical either
# way. See the comment on the install(CODE) block that installs this file
# in CMakeLists.txt for more detail.
export LD_LIBRARY_PATH="@CMAKE_INSTALL_FULL_LIBDIR@/antscopez${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "@CMAKE_INSTALL_FULL_LIBDIR@/antscopez/AntScopeZ.bin" "$@"
