#!/bin/sh
#
# Generated by CMakeLists.txt at configure time (configure_file()) -- do
# not edit this file directly, edit cmake/antscopez-wrapper.sh.in instead.
#
# This replaces the real AntScopeZ binary at its install location; the
# actual binary is installed alongside it as AntScopeZ.bin. It exists
# because $ORIGIN-relative RPATH on the binary/plugins isn't sufficient by
# itself for Qt's plugin loader to reliably resolve every symbol it needs
# from the bundled Qt 6.11 libraries -- confirmed by testing that setting
# LD_LIBRARY_PATH explicitly (below) fixes a real crash
# ("qxcb: undefined symbol ... version Qt_6_PRIVATE_API") that RPATH alone
# does not, even though the resolved library files are identical either
# way. See the comment on the install(CODE) block that installs this file
# in CMakeLists.txt for more detail.
export LD_LIBRARY_PATH="@CMAKE_INSTALL_FULL_LIBDIR@/antscopez${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$(dirname "$0")/AntScopeZ.bin" "$@"
